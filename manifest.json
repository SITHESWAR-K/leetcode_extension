{
  "manifest_version": 3,
  "name": "LeetCode Company Tags & Filters",
  "version": "1.0.0",
  "description": "Unlock company interview tags, frequency stats, and company-wise filters for all LeetCode problems.",
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "LeetCode Company Tags",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://*.leetcode.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/data/problem_to_companies.json",
        "src/data/company_to_problems.json",
        "src/data/companies_meta.json",
        "src/dashboard/*",
        "src/assets/*"
      ],
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ]
    }
  ]
}
